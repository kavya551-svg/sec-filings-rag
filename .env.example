# Copy this file to .env and fill in your values. Never commit .env.

# The SEC requires a User-Agent with your name and email for automated requests.
SEC_USER_AGENT="Your Name your-email@example.com"

# --- Language model -----------------------------------------------------------
# Free (default): Ollama runs open-source models on your computer. https://ollama.com
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1

# Paid: Claude API. Get a key at https://console.anthropic.com
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Any OpenAI-compatible endpoint
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- Optional -----------------------------------------------------------------
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TOP_K=6
